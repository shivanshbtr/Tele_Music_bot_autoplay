# ── Required ──────────────────────────────────────────────────────────────────
# Get from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# ── Optional ──────────────────────────────────────────────────────────────────
# Path to a cookies.txt exported from a logged-in YouTube session.
# Only needed if you keep hitting "Sign in to confirm you're not a bot".
# See README.md > Troubleshooting for how to export one.
YTDLP_COOKIES_FILE=cookies_file_path_here

# Your numeric Telegram user ID (get it from @userinfobot).
# Only this user can run /updatecookies to push a fresh cookies.txt
# by sending it as a file — no server/terminal access needed.
TELEGRAM_OWNER_ID=your_numeric_telegram_user_id_here

# Comma-separated numeric Telegram user IDs allowed to use the bot at all.
# The owner above is always allowed even if not listed here.
# Leave blank (along with TELEGRAM_OWNER_ID) to leave the bot open to anyone.
TELEGRAM_ALLOWED_USER_IDS=111111111,222222222
